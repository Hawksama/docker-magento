#!/usr/bin/env bash

# ---------------------------------------------------------------------------
# Logging re-exec.
#
# Must run BEFORE `set -o errexit`. The parent branch deliberately does not
# enable errexit: if it did, the failing pipeline below would kill the parent
# before it could read PIPESTATUS and report the child's real exit code.
# ---------------------------------------------------------------------------
if [ -z "$SETUP_LOGGING" ] && [ -z "$SETUP_NO_LOG" ]; then
    _want_log=1
    for _a in "$@"; do
        [ "$_a" = "-h" ] && _want_log=0
    done
    if [ "$_want_log" = "1" ]; then
        mkdir -p setup-logs
        export SETUP_LOGGING=1
        export SETUP_LOG_FILE="setup-logs/setup-$(date +%Y%m%d-%H%M%S).log"
        # Capture TTY-ness now, before the pipe exists, so colour detection and
        # the `[ -t 0 ]` interactivity guards downstream see the truth.
        if [ -t 1 ]; then export SETUP_STDOUT_TTY=1; else export SETUP_STDOUT_TTY=0; fi
        set -o pipefail
        "$0" "$@" 2>&1 | tee "$SETUP_LOG_FILE"
        exit "${PIPESTATUS[0]}"
    fi
fi

set -o errexit

start_time=$(date +%s)  # Record the start time

LOG_FILE="$SETUP_LOG_FILE"

# Define text formatting. Guarded: under errexit an unset or dumb TERM makes
# tput exit non-zero, which would kill the script before it does anything.
if [ "${SETUP_STDOUT_TTY:-1}" = "1" ] && command -v tput >/dev/null 2>&1 \
   && tput setaf 1 >/dev/null 2>&1; then
    bold=$(tput bold)
    normal=$(tput sgr0)
    green=$(tput setaf 2)
    yellow=$(tput setaf 3)
    red=$(tput setaf 1)
    blue=$(tput setaf 4)
else
    bold=""; normal=""; green=""; yellow=""; red=""; blue=""
fi

help() {
    # Display Help
    echo "${bold}${blue}Prepare docker setup for project.${normal}"
    echo
    echo "Syntax: bin/setup [-m] [-n] [-i] [-v VERSION] [--regen-compose] [--tolerate-optional]"
    echo "options:"
    echo "  ${bold}h${normal}     Print this Help."
    echo "  ${bold}m${normal}     Prepare environment for macOS."
    echo "  ${bold}n${normal}     Perform a new setup after using bin/download to initialize ./src with a new Magento project."
    echo "  ${bold}i${normal}     Interactive: re-enable prompts that are skipped by default."
    echo "  ${bold}v${normal}     Specify Magento version for compose file (e.g., 2.3.3, 2.3.7, 2.4.6-php8.1, latest)"
    echo
    echo "  ${bold}--regen-compose${normal}      Regenerate compose.yaml/compose.dev.yaml from the samples."
    echo "                       Off by default: it overwrites local edits and there is no git history here."
    echo "  ${bold}--tolerate-optional${normal}  Exit 0 even when optional steps failed."
    echo
    echo "Exit codes: 0 = clean, 1 = a required step failed, 2 = usable but optional steps failed."
    echo
    echo "Environment:"
    echo "  SETUP_SKIP_INDEXERS   Comma-separated indexer ids to skip (known-broken third-party indexers)."
    echo "  SETUP_NO_LOG          Set to disable writing setup-logs/."
    echo
}

# Default to non-interactive; -i restores prompts.
NONINTERACTIVE=1
export NONINTERACTIVE

# Pre-scan long options and strip them, leaving short options for getopts.
LONGARGS=()
for arg in "$@"; do
    case "$arg" in
        --regen-compose)     REGEN_COMPOSE=1 ;;
        --tolerate-optional) TOLERATE_OPTIONAL=1 ;;
        --interactive)       unset NONINTERACTIVE ;;
        *)                   LONGARGS+=("$arg") ;;
    esac
done
set -- "${LONGARGS[@]}"

# Parse parameters
while getopts ":hmniv:" opt; do
    case ${opt} in
        h )
            help
            exit 0
            ;;
        m )
            MACSETUP=1
            echo "${yellow}Parameter -m detected${normal}"
            ;;
        n )
            NEWSETUP=1
            echo "${yellow}Parameter -n detected${normal}"
            ;;
        i )
            unset NONINTERACTIVE
            echo "${yellow}Parameter -i detected: prompts enabled${normal}"
            ;;
        v )
            VERSION=$OPTARG
            echo "${yellow}Parameter -v detected with value ${VERSION}${normal}"
            ;;
        \? )
            echo "${red}Invalid option: $OPTARG${normal}" 1>&2
            help
            exit 1
            ;;
        : )
            echo "${red}Invalid option: $OPTARG requires an argument${normal}" 1>&2
            help
            exit 1
            ;;
    esac
done

# Composer must never stop to ask for credentials mid-install.
export COMPOSER_NO_INTERACTION=1

# ---------------------------------------------------------------------------
# Step runner
#
# run_required : on failure, report and abort with the command to re-run.
# run_optional : on failure, warn, record it, and keep going.
#
# `if cmd; then ... else rc=$?; fi` is used rather than `cmd || true` or
# `set +e`. POSIX ignores -e for a command used as an `if` condition, and $?
# in the else branch is that command's real status. `|| true` throws the exit
# code away; `set +e` mutates global shell state and any early return between
# the toggles silently leaves errexit off for the rest of the run.
#
# IMPORTANT: only ever pass an EXTERNAL command (a bin/* script or a binary).
# When a shell *function* is used as an `if` condition, -e is disabled for its
# entire dynamic extent, so it would run past its own internal failures and
# still return 0, silently swallowing the error. Use run_optional_sh for
# anything needing a pipeline or a fallback.
# ---------------------------------------------------------------------------
STEP_NUM=0
OK_NAMES=()
SKIPPED_NAMES=()
FAILED_NAMES=()
FAILED_CMDS=()
FAILED_RCS=()

_join_cmd() {
    local a out=""
    for a in "$@"; do out="$out $(printf '%q' "$a")"; done
    printf '%s' "${out# }"
}

_banner() {
    STEP_NUM=$((STEP_NUM + 1))
    printf '%s\n' "${blue}==> [${STEP_NUM}] $1${normal}"
}

# The `else rc=$?` is required, not stylistic. An `if` whose condition fails
# with no else branch returns 0, so reading $? after `fi` would always capture 0
# and throw away the real exit code. Inside the else branch, $? is the
# condition's own status.
run_required() {
    local name="$1" rc=0
    shift
    _banner "$name"
    if "$@"; then
        OK_NAMES+=("$name")
        return 0
    else
        rc=$?
    fi
    printf '%s\n' "${red}${bold}STEP FAILED (required): ${name}${normal}" >&2
    printf '%s\n' "${red}  exit code: ${rc}${normal}" >&2
    printf '%s\n' "${red}  re-run   : cd $(pwd) && $(_join_cmd "$@")${normal}" >&2
    print_summary
    exit 1
}

run_optional() {
    local name="$1" rc=0
    shift
    _banner "$name"
    if "$@"; then
        OK_NAMES+=("$name")
        return 0
    else
        rc=$?
    fi
    printf '%s\n' "${yellow}${bold}STEP FAILED (optional, continuing): ${name} (exit ${rc})${normal}" >&2
    FAILED_NAMES+=("$name")
    FAILED_CMDS+=("$(_join_cmd "$@")")
    FAILED_RCS+=("$rc")
    # Returning non-zero here would let errexit kill the script at the call
    # site, which is the exact failure mode this runner exists to prevent.
    return 0
}

# For steps needing a pipeline or a fallback. Uses bash -c (not eval) so the
# snippet gets its own errexit scope.
run_required_sh() { local n="$1"; shift; run_required "$n" /bin/bash -c "$1"; }
run_optional_sh() { local n="$1"; shift; run_optional "$n" /bin/bash -c "$1"; }

run_skip() {
    SKIPPED_NAMES+=("$1 ($2)")
    printf '%s\n' "${yellow}--  SKIP $1 ($2)${normal}"
}

print_summary() {
    local i=0 n
    echo
    echo "${bold}${blue}──────────────── setup summary ────────────────${normal}"
    echo "${green}Completed: ${#OK_NAMES[@]} step(s)${normal}"
    if [ "${#SKIPPED_NAMES[@]}" -gt 0 ]; then
        echo "${yellow}Skipped:${normal}"
        for n in "${SKIPPED_NAMES[@]}"; do echo "  - $n"; done
    fi
    if [ "${#FAILED_NAMES[@]}" -eq 0 ]; then
        echo "${green}No failures.${normal}"
    else
        echo "${yellow}${bold}Optional steps that FAILED (${#FAILED_NAMES[@]}):${normal}"
        while [ "$i" -lt "${#FAILED_NAMES[@]}" ]; do
            echo "  ${yellow}x ${FAILED_NAMES[$i]}${normal} (exit ${FAILED_RCS[$i]})"
            echo "      re-run: ${FAILED_CMDS[$i]}"
            i=$((i + 1))
        done
    fi
    [ -n "$LOG_FILE" ] && echo "${blue}Full log: ${LOG_FILE}${normal}"
    echo "${bold}${blue}───────────────────────────────────────────────${normal}"
}

# ---------------------------------------------------------------------------
# Preconditions
# ---------------------------------------------------------------------------
if ! docker info >/dev/null 2>&1; then
    echo "${red}Docker is not running (or the daemon is unreachable).${normal}" >&2
    echo "${red}Start Docker Desktop and try again.${normal}" >&2
    exit 1
fi

# Raw bytes, so there is no bc dependency and no GiB/MiB unit fragility.
MEM=$(docker info --format '{{.MemTotal}}' 2>/dev/null)
case "$MEM" in
    ''|*[!0-9]*)
        echo "${yellow}Warning: could not read Docker memory; skipping the RAM check.${normal}" >&2
        ;;
    *)
        if [ "$MEM" -lt 6120000000 ]; then
            echo "${red}Docker has $((MEM / 1000000000))GB allocated; at least 6GB is required.${normal}" >&2
            exit 1
        fi
        ;;
esac

bin/update_phpfpm_env

# shellcheck source=../env/db.env
source env/db.env
# shellcheck source=../env/magento.env
source env/magento.env
# shellcheck source=../env/rabbitmq.env
source env/rabbitmq.env
# shellcheck source=../env/phpfpm.env
source env/phpfpm.env

# Exported so the `bash -c` steps below can see them.
export MAGENTO_ADMIN_USER MAGENTO_ADMIN_PASSWORD MAGENTO_ADMIN_EMAIL
export MAGENTO_ADMIN_FIRST_NAME MAGENTO_ADMIN_LAST_NAME

DOMAIN=${MAGENTO_DOMAIN}

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------

# bin/stopall stops every container on the host, including unrelated projects.
run_optional "stop project containers" bin/stopall

# bin/cpsample overwrites compose.yaml and compose.dev.yaml unconditionally.
# Opt-in only: local edits to those files are not recoverable (no git repo).
if [ -n "$REGEN_COMPOSE" ] || [ ! -f compose.yaml ]; then
    if [ -z $MACSETUP ]; then
        echo "${green}Preparing setup installation for Linux environment and domain ${DOMAIN}${normal}"
        if [ -n "$VERSION" ]; then
            if [ "$VERSION" == "2.3.3" ]; then
                run_required "cpsample (linux, 2.3.7)" bin/cpsample -v "2.3.7"
            else
                run_required "cpsample (linux, $VERSION)" bin/cpsample -v "$VERSION"
            fi
        else
            run_required "cpsample (linux)" bin/cpsample
        fi
    else
        echo "${green}Preparing setup installation for macOS environment and domain ${DOMAIN}${normal}"
        if [ -n "$VERSION" ]; then
            if [ "$VERSION" == "2.3.3" ]; then
                run_required "cpsample (macOS, 2.3.7)" bin/cpsample -m -v "2.3.7"
            else
                run_required "cpsample (macOS, $VERSION)" bin/cpsample -m -v "$VERSION"
            fi
        else
            run_required "cpsample (macOS)" bin/cpsample -m
        fi
    fi
else
    run_skip "cpsample" "compose files exist; pass --regen-compose to overwrite"
fi

run_required "start containers" bin/start --no-dev

# Checks the container's global composer config, which compose.yaml bind-mounts
# from ~/.composer, so credentials survive container recreation.
run_required "composer auth" bin/setup-composer-auth

run_optional "check broken symlinks" bin/check-broken-symlinks --auto-delete

echo "${blue}Copying project files to container...${normal}"
run_required "copy project to container" bin/copytocontainer --all

echo "${blue}Adding Magento modules to Composer allow-plugins directive...${normal}"
run_required "allow-plugins: magento-composer-installer" \
    bin/clinotty composer config --no-plugins allow-plugins.magento/magento-composer-installer true
run_required "allow-plugins: inventory-composer-installer" \
    bin/clinotty composer config --no-plugins allow-plugins.magento/inventory-composer-installer true
run_required "allow-plugins: laminas-dependency-plugin" \
    bin/clinotty composer config --no-plugins allow-plugins.laminas/laminas-dependency-plugin true

echo "${blue}Installing composer modules...${normal}"
run_required "composer install" bin/composer install --ignore-platform-reqs --no-interaction

if [ "$VERSION" == "2.3.3" ] || [ "$VERSION" == "2.3.7" ]; then
    echo "${green}Composer install completed.${normal}"
    echo "${yellow}Please fix the xdebug bug by editing the vendor/magento/magento2-functional-testing-framework/src/Magento/FunctionalTestingFramework/_bootstrap.php${normal}"
    echo "${yellow}You can find the fix on: https://tinyurl.com/mrdr4jn${normal}"
    run_optional "fix xdebug (legacy 2.3.x)" bin/fix_xdebug
fi

run_optional "check requirements" bin/check-requirements

echo "${blue}Setting bin/magento executable permissions${normal}"
run_required "chmod bin/magento" bin/clinotty chmod u+x bin/magento

if [ -n "$NEWSETUP" ]; then
    echo "${green}Performing a new setup from scratch for domain ${DOMAIN}${normal}"
    run_required "setup:install" bin/setup-install
else
    echo "${blue}Importing database...${normal}"
    run_required "recreate database" bin/cli mysql -h"db" -u"magento" -p"magento" \
        --execute="DROP DATABASE magento; CREATE DATABASE magento;"
    run_required "import database" bin/mysqlimport
fi

echo "${blue}Copying composer.lock from container to host...${normal}"
run_optional "copy composer.lock to host" bin/copyfromcontainer composer.lock

echo "${blue}Cleaning redis cache and generated files...${normal}"
run_required "flush redis" bin/redis redis-cli flushall
run_required "remove generated/" bin/clinotty rm -rf generated
run_required_sh "clear var/" 'bin/clinotty rm -rf var/*'

if [ -n "$VERSION" ] && [ "$VERSION" == "2.3.3" ]; then
    echo "${yellow}Reverting docker configuration to PHP 7.3 after composer:install has finished to avoid setup:di:compile errors${normal}"
    if [ -z $MACSETUP ]; then
        run_required "cpsample revert to 2.3.3 (linux)" bin/cpsample -v "2.3.3"
    else
        run_required "cpsample revert to 2.3.3 (macOS)" bin/cpsample -m -v "2.3.3"
    fi
    run_required "stop containers (revert)" bin/stop
    run_required "start containers (revert)" bin/start --no-dev
fi

run_required "app:config:import" bin/clinotty bin/magento app:config:import

echo "${blue}Preparing \$_ENV variables in env.php; variables are available in PHPFPM through .env files${normal}"
run_optional "config:set dev/restrict/allow_ips" \
    bin/clinotty bin/magento config:set 'dev/restrict/allow_ips' '' --lock-env

echo "${blue}Attempting to set up search engine...${normal}"
run_required "setup search engine" bin/setup-search-engine --lock-env --non-interactive
run_optional "copy env.php to host" bin/copyfromcontainer app/etc/env.php

echo "${blue}Running magento setup:upgrade...${normal}"
run_required "setup:upgrade" bin/clinotty bin/magento setup:up

echo "${blue}Ensuring admin user ${MAGENTO_ADMIN_USER} exists with password ${MAGENTO_ADMIN_PASSWORD}.${normal}"
run_optional_sh "admin user" '
    if bin/clinotty bin/magento admin:user:create \
        --admin-user="$MAGENTO_ADMIN_USER" \
        --admin-password="$MAGENTO_ADMIN_PASSWORD" \
        --admin-email="$MAGENTO_ADMIN_EMAIL" \
        --admin-firstname="$MAGENTO_ADMIN_FIRST_NAME" \
        --admin-lastname="$MAGENTO_ADMIN_LAST_NAME"; then
        exit 0
    fi
    echo "Admin user creation failed (likely already exists with a different email — common when a production DB was imported). Resetting password via n98-magerun2."
    bin/clinotty bin/n98-magerun2 admin:user:change-password "$MAGENTO_ADMIN_USER" "$MAGENTO_ADMIN_PASSWORD"
'

echo "${blue}Forcing deploy of static content to speed up initial requests.${normal}"
run_optional "static content deploy" bin/clinotty bin/magento setup:static-content:deploy -f

echo "${blue}Updating active theme in env/theme.env${normal}"
run_optional "update active theme" bin/update-active-theme

if [ -n "$MACSETUP" ]; then
    run_optional "copy lib to host" bin/copyfromcontainer lib
    run_optional "copy nginx.conf.sample to host" bin/copyfromcontainer nginx.conf.sample
fi

if [ -n "$MACSETUP" ]; then
    echo "${blue}Copying files from container to host.${normal}"
    run_optional "copy dev to host" bin/copyfromcontainer dev
    run_optional "copy pub/media to host" bin/copyfromcontainer pub/media
fi

if [ -n "$NEWSETUP" ]; then
    echo "${blue}Copying app folder from container to host.${normal}"
    run_optional "copy app to host" bin/copyfromcontainer app

    run_optional "create auth.json" bin/clinotty cp auth.json.sample auth.json
    run_optional "copy auth.json to host" bin/copyfromcontainer auth.json
    mkdir -p src/dbdump
fi

echo "${blue}Setting basic URL and generating SSL certificate.${normal}"
run_required "domain and SSL certificate" bin/setup-domain "${DOMAIN}"

echo "${blue}Re-indexing with selected search engine.${normal}"
run_optional "reindex" bin/reindex-tolerant

echo "${blue}Clearing the cache to apply updates.${normal}"
run_required "cache:flush" bin/clinotty bin/magento cache:flush

echo "${blue}Installing cron, run 'bin/cron start' to enable${normal}"
run_optional "cron:install" bin/clinotty bin/magento cron:install

echo "${blue}Turning on developer mode.${normal}"
run_required "deploy:mode:set developer" bin/clinotty bin/magento deploy:mode:set developer

if [ -n "$MACSETUP" ]; then
    echo "${blue}Copying files from container to host.${normal}"
    run_optional "copy vendor to host" bin/copyfromcontainer vendor
    run_optional "copy generated to host" bin/copyfromcontainer generated
fi

echo "${blue}Update the store urls...${normal}"
# --all is required: without it bin/update-urls opens an interactive fzf picker,
# and fzf reads /dev/tty directly, so redirecting stdin cannot prevent the hang.
run_required "update store urls" bin/update-urls --all

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
print_summary

echo "${green}Docker development environment setup complete.${normal}"
echo "${green}You may now access your Magento instance at https://${DOMAIN}/${normal}"

end_time=$(date +%s)
elapsed_seconds=$(( end_time - start_time ))

# Convert total seconds to minutes and seconds
elapsed_minutes=$(( elapsed_seconds / 60 ))
remaining_seconds=$(( elapsed_seconds % 60 ))

echo "${blue}Total execution time: ${elapsed_minutes} minute(s) and ${remaining_seconds} second(s)${normal}"

if [ "${#FAILED_NAMES[@]}" -gt 0 ] && [ -z "$TOLERATE_OPTIONAL" ]; then
    echo "${yellow}exit 2 = the environment is usable, but ${#FAILED_NAMES[@]} optional step(s) failed (see summary above).${normal}"
    exit 2
fi

exit 0

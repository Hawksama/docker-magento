#!/usr/bin/env bash

# Define text formatting
bold=$(tput bold)
normal=$(tput sgr0)
green=$(tput setaf 2)
yellow=$(tput setaf 3)
red=$(tput setaf 1)
blue=$(tput setaf 4)

# Function to fix the SQL file by replacing problematic lines or collations
fix_sql_file() {
  local original_file="$1"
  local fixed_file="${original_file%.sql}_fixed.sql"
  local needs_fix=false

  # Check if the file contains the problematic collation or the sandbox mode line
  if bin/cli grep -q 'utf8mb4_0900_ai_ci' "$original_file" || bin/cli grep -q 'enable the sandbox mode' "$original_file"; then
    needs_fix=true
  fi

  if [ "$needs_fix" = true ]; then
    # Create the fixed file
    bin/cli cp "$original_file" "$fixed_file"

    # Replace the problematic collation in the new file
    bin/cli sed -i 's/utf8mb4_0900_ai_ci/utf8mb4_general_ci/g' "$fixed_file"

    # Remove the sandbox mode line if it exists
    bin/cli sed -i '/enable the sandbox mode/d' "$fixed_file"
  else
    # No need to fix the file if none of the issues are present
    fixed_file="$original_file"  # Use the original file as is
  fi

  echo "$fixed_file"
}

# Function to select a file if there are multiple, or return the single file if only one exists.
#
# This runs inside a command substitution -- path=$(select_file) -- so `exit`
# here only kills the subshell. Diagnostics therefore go to stderr (stdout is
# the return channel) and the caller must test the return status.
select_file() {
  files=$(bin/cli find dbdump -iregex '.*\.\(sql\|gz\)')
  file_count=$(echo "$files" | wc -w)

  if [ "$file_count" -eq 0 ]; then
    echo "${red}${bold}Error:${normal} There are no *.sql or *.gz files in the dbdump directory." >&2
    return 1
  elif [ "$file_count" -eq 1 ]; then
    echo "$files"  # Return the single file
  elif [ -n "$NONINTERACTIVE" ] || [ ! -t 0 ]; then
    # Deterministic choice for unattended runs: the most recently modified dump.
    chosen=$(bin/cli bash -c "ls -t \$(find dbdump -iregex '.*\.\(sql\|gz\)') 2>/dev/null | head -1" | tr -d '\r')
    if [ -z "$chosen" ]; then
      echo "${red}${bold}Error:${normal} could not determine the newest dump in dbdump." >&2
      return 1
    fi
    echo "${yellow}Multiple dumps found; non-interactive run selected the newest:${normal} $chosen" >&2
    echo "$chosen"
  else
    select file in $files; do
      if [ -n "$file" ]; then
        echo "$file"
        return 0
      else
        echo "${red}${bold}Invalid selection. Please try again.${normal}" >&2
        return 1
      fi
    done
  fi
}

# Function to handle archive files (unarchive if needed)
unarchive_file() {
  local file="$1"
  local extension="${file##*.}"

  if [ "$extension" = "gz" ]; then
    local unzipped_file="${file%.gz}"
    bin/cli gunzip -dv "$file"
    echo "$unzipped_file"
  else
    echo "$file"
  fi
}

# Function to import a SQL file into the new database
import_sql_file() {
  local file="$1"
  echo "Using file: $file"

  # Unarchive if needed and fix collation
  local unarchived_file
  unarchived_file=$(unarchive_file "$file")
  local fixed_file
  fixed_file=$(fix_sql_file "$unarchived_file")

  echo "Importing $fixed_file into the new database..."
  bin/n98-magerun2 -v db:import "$fixed_file"
}

# Main script
echo "${blue}${bold}Starting database import script...${normal}"

if [ -z "$1" ]; then
  # select_file cannot abort the script from inside $( ), so check its status.
  if ! path=$(select_file); then
    exit 1
  fi
  if [ -z "$path" ]; then
    echo "${red}${bold}Error:${normal} no dump file selected." >&2
    exit 1
  fi
else
  path="$1"
  echo "${yellow}${bold}File provided as argument:${normal} $path"
fi

extension="${path##*.}"

echo "${blue}${bold}Selected file:${normal} $path"

# Try to import the selected file and capture any errors
if import_sql_file "$path" 2>&1; then
  echo "${green}${bold}Import completed successfully.${normal}"
else
  echo "${red}${bold}Error:${normal} Import failed. Please check the output above for details."
  exit 1
fi
